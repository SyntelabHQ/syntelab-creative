{
  "name": "syntelab-creative",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Syntelab Creative: one program, many apps.",
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/*",
    "apps/*/frontend",
    "shell"
  ],
  "scripts": {
    "predev": "node tools/fetch-pdfium.mjs",
    "dev": "npm run tauri --workspace @syntelab/shell -- dev",
    "dev:web": "npm run dev --workspace @syntelab/shell",
    "prebuild": "node tools/fetch-pdfium.mjs",
    "build": "npm run tauri --workspace @syntelab/shell -- build",
    "build:web": "npm run build --workspace @syntelab/shell",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
